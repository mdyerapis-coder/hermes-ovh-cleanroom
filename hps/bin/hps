#!/usr/bin/env bash
# HPS CLI — Hermes Provisioning System v1
# Sole infrastructure/runtime mutation authority.
set -Eeuo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
export HERMES_REPO="${HERMES_REPO:-$ROOT}"

# Prefer system state dir; core falls back if unwritable
export HPS_STATE_DIR="${HPS_STATE_DIR:-/var/lib/hermes-hps}"

if [[ "${1:-}" == "help" || "${1:-}" == "-h" || "${1:-}" == "--help" || $# -eq 0 ]]; then
  cat <<'EOF'
usage: hps <command> [args]

commands:
  inventory              Authoritative host inventory + local identity
  target [-e ENV] [--host ID]
  preflight [-e ENV] [--host ID]
  plan [-e ENV] [--host ID]
  apply [-e ENV] [--host ID] [--plan-id ID] [--plan-digest DIGEST]
  verify [-e ENV] [--host ID]
  resume [-e ENV] [--host ID]
  rollback [-e ENV] [--host ID]
  backup
  restore-test
  restore [-e ENV] [--host ID]
  releases
  drift [-e ENV] [--host ID]
  secrets-refs
  protect [-e ENV] [--host ID]
  reboot-persistence
  cutover status|transition|arm|disarm

environments: cleanroom | production | rollback | test

Production mutation requires valid local arm state and cutover ARMED+.
EOF
  exit 0
fi

# Baseline aliases preserved: preflight|plan|apply|verify|resume
exec python3 "$ROOT/hps/lib/hps_core.py" "$@"
