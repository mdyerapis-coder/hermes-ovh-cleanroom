[Unit]
Description=Hermes Agent (OVH clean-room)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/hermes-cleanroom/shared/venvs/hermes/bin/python

[Service]
Type=simple
User=hermes
Group=hermes
WorkingDirectory=/opt/hermes-cleanroom/shared/hermes-home
EnvironmentFile=-/opt/hermes-cleanroom/shared/hermes-home/cleanroom.env
Environment=HOME=/opt/hermes-cleanroom/shared/hermes-home
Environment=HERMES_ENV=cleanroom
# Prefer hermes CLI if installed; fallback sleep-keep for placeholder
ExecStart=/bin/bash -c 'if [[ -x /opt/hermes-cleanroom/shared/venvs/hermes/bin/hermes ]]; then exec /opt/hermes-cleanroom/shared/venvs/hermes/bin/hermes --help >/dev/null; exec sleep infinity; else echo "hermes binary missing"; sleep infinity; fi'
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/hermes-cleanroom/shared

[Install]
WantedBy=multi-user.target
