[Unit]
Description=Hermes Agent (clean-room)
After=network-online.target
ConditionPathExists=/opt/hermes-cleanroom/current

[Service]
Type=simple
User=hermes
Group=hermes
WorkingDirectory=/opt/hermes-cleanroom/current
Environment=HERMES_ENV=cleanroom
# Placeholder until agent runtime is fully installed via audited PR
ExecStart=/bin/bash -c 'echo "hermes-agent placeholder; install via audited runtime PR"; sleep infinity'
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/hermes-cleanroom/shared

[Install]
WantedBy=multi-user.target
